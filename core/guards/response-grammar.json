{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CentinelaStepOutput",
  "type": "object",
  "required": ["step", "status", "artifacts", "next_action"],
  "properties": {
    "step": {
      "type": "string",
      "enum": ["VISUAL_PLAN", "TDD_RED", "IMPLEMENT_GREEN", "SELF_HEAL", "AUDIT"]
    },
    "status": {
      "type": "string",
      "enum": ["IN_PROGRESS", "GATE_PENDING", "COMPLETED", "FAILED"]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "action"],
        "properties": {
          "path": { "type": "string" },
          "action": { "type": "string", "enum": ["CREATE", "MODIFY", "DELETE"] },
          "content": { "type": "string" }
        }
      }
    },
    "execution_payload": {
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "timeout_seconds": { "type": "integer", "maximum": 120 }
      }
    },
    "next_action": {
      "type": "string"
    }
  },
  "additionalProperties": false
}